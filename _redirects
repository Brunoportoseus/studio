# Redirecionamentos de URLs legadas (site antigo) para a estrutura atual.
# O Cloudflare Pages ja serve URLs limpas (/blog em vez de /blog.html) e
# redireciona /blog.html -> /blog automaticamente; por isso NAO redirecionamos
# /blog -> /blog.html (isso criaria um loop de redirecionamento).
/blog/publicacao/*   /blog   301

# URLs .html antigas: o Cloudflare Pages ja redireciona /pagina.html -> /pagina
# (301, um salto) para todas as paginas do projeto. NAO criar regras
# /pagina.html -> / : o Google trata redirecionamento para a home como soft 404.
/index.html          /       301

# Paginas antigas que davam 404
/marco-moura         /remocao  301
# Provisorio ate existir a pagina /denise-de-paula
/denise-de-paula     /       301

